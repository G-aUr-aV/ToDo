{
  "name": "todo-daylight",
  "version": "0.1.0",
  "description": "A lightweight, self-hosted task app backed by an Obsidian vault, with Mini Today and Chrome app launchers.",
  "author": "Todo contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-node.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run test:setup",
    "start": "node scripts/start.mjs",
    "server:dev": "node --import tsx server/main.ts",
    "setup": "node scripts/setup.mjs",
    "test:setup": "node scripts/local-smoke.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "chokidar": "5.0.0",
    "fastify": "5.12.7",
    "proper-lockfile": "4.1.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "jszip": "3.10.2",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/G-aUr-aV/ToDo.git",
    "directory": "app"
  },
  "bugs": {
    "url": "https://github.com/G-aUr-aV/ToDo/issues"
  }
}
