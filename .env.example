# Optional settings. Copy to .env at the workspace root; npm start loads it too.
# Source server defaults to http://localhost:4310 with these local folders.
# VAULT_PATH and STATE_PATH are relative to app/ when using npm start.
# VAULT_PATH=../Todo Vault
# STATE_PATH=../.todo-state/server
# HOST=127.0.0.1
# PORT=4310
# PUBLIC_ORIGIN=http://localhost:4310

# Docker Compose: start-docker.sh fills UID/GID automatically on first run.
TODO_UID=1000
TODO_GID=1000
TODO_PORT=4310
TODO_VAULT_PATH=./Todo Vault
TODO_STATE_PATH=./.todo-state/server
TODO_PUBLIC_ORIGIN=http://localhost:4310
